# ============================================================================
#  Plateforme Data Lakehouse — variables d'environnement centralisées
#  DIT — M2 Ingénierie des Données / Big Data — Examen M. PENE
# ----------------------------------------------------------------------------
#  Un seul fichier de configuration pour tous les services : les identifiants
#  et les noms de buckets ne sont écrits qu'une fois et sont injectés dans
#  NiFi, Spark, Airflow, Dremio et les scripts d'initialisation.
# ============================================================================

COMPOSE_PROJECT_NAME=dit-lakehouse

# ---------------------------------------------------------------- MinIO -----
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=lakehouse123
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

# Deux buckets strictement séparés (contrainte 3.1.2 du sujet)
RAW_BUCKET=lakehouse-raw
WAREHOUSE_BUCKET=lakehouse-warehouse

# ------------------------------------------------------------- PostgreSQL ---
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse123
POSTGRES_DB=lakehouse
# Bases créées par scripts/postgres-init/00-create-databases.sql
AIRFLOW_DB=airflow
NESSIE_DB=nessie
DREMIO_DB=dremio

# ------------------------------------------------------------------ Nessie --
NESSIE_URI=http://nessie:19120/api/v2
NESSIE_REF=main
NESSIE_CATALOG_NAME=nessie

# ------------------------------------------------------------------- Spark --
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=2g

# ----------------------------------------------------------------- Airflow --
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__CORE__FERNET_KEY=UKMzEm3yIuFYEq1y3-2FxPNWSVwRASpahmQ9kQfEr8E=
AIRFLOW__WEBSERVER__SECRET_KEY=dit-lakehouse-secret-key

# -------------------------------------------------------------------- NiFi --
# Accès HTTP simplifié (voir docs/architecture.md §2.4 pour la justification)
NIFI_WEB_HTTP_PORT=8080
NIFI_LISTEN_HTTP_PORT=9095
NIFI_SENSITIVE_PROPS_KEY=dit-lakehouse-nifi-sensitive-key-2026

# --------------------------------------------------------- Source imposée ---
FAKESTORE_API_BASE_URL=https://fakestoreapi.com

# ------------------------------------------- Historique reconstitué 6 mois --
# Voir docs/architecture.md §4 : stratégie d'historisation
HISTORY_MONTHS=6
HISTORY_END_DATE=today
SYNTHETIC_HISTORY_ENABLED=true
SYNTHETIC_HISTORY_SEED=20260909
